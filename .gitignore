# Dependencies
/vendor
/node_modules

# Environment files — djbb-lite keeps DATABASE_URL and the app key the same way.
# .env.local wins over .env (see bootstrap/app.php); neither is ever committed.
.env
.env.*
!.env.example
auth.json

# Laravel runtime
*.log
/.phpunit.cache
.phpunit.result.cache
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/bootstrap/cache/*.php
!bootstrap/cache/.gitignore
Homestead.json
Homestead.yaml

# Local databases (this project only speaks Postgres, but keep the guard)
*.sqlite
*.sqlite-journal

# Editors and OS
.idea
/.vscode
/.zed
/.cursor/
.nova
_ide_helper.php
.phpactor.json
.DS_Store
Thumbs.db
