# Copy to .env and fill in the blanks. config/database.php refuses to boot without a
# Postgres connection, so the only mandatory value is DATABASE_URL.
#
# djbb-lite keeps its credentials in .env.local; copy that DATABASE_URL line straight over.
# Do not create .env.local here - Laravel loads .env.{APP_ENV} *instead of* .env, so the
# file would swallow APP_KEY and every request would 500.

# Application signing key. Generate one:
#   php artisan key:generate
APP_KEY=

APP_DEBUG=true
APP_URL=http://127.0.0.1:7112

# Neon Postgres connection string, pooled endpoint. Query params (sslmode, channel_binding)
# are parsed off the URL and passed through to libpq.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-1.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Only needed if you would rather not put credentials in one URL:
# DB_HOST=ep-xxx-pooler.c-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=user
# DB_PASSWORD=password
# DB_SSLMODE=require
# DB_CHANNEL_BINDING=require

# There is no SQLite fallback in this project.
